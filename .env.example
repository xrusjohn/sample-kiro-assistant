# ──────────────────────────────────────────────
# Agent Configuration
# ──────────────────────────────────────────────

# Override the Kiro CLI binary path (default: kiro-cli)
# KIRO_BINARY=kiro-cli

# Override the Claude Code CLI binary path (default: claude)
# CLAUDE_BINARY=claude

# Server-side default agent: "kiro" or "claude-code" (default: kiro)
# The UI-level preference (stored in localStorage) takes precedence.
# DEFAULT_AGENT=kiro

# ──────────────────────────────────────────────
# Deprecated (use the variables above instead)
# ──────────────────────────────────────────────

# KIRO_CLI_BINARY  — replaced by KIRO_BINARY
# KIRO_AGENT       — agent name is now part of the agent definition
